{
  "manifest_version": 3,
  "name": "SnipDeck",
  "description": "A simple Chrome extension to manage text snippets and screenshots. Now featuring text to speech!",
  "version": "2.0",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "desktopCapture"
  ],
  "action": {
    "default_popup": "/popup/popup.html",
    "default_icon": {
      "16": "/assets/icon.png",
      "48": "/assets/icon.png",
      "128": "/assets/icon.png"
    }
  },
  "icons": {
    "16": "/assets/icon.png",
    "48": "/assets/icon.png",
    "128": "/assets/icon.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
