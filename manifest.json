{
  "manifest_version": 3,
  "name": "SnipDeck",
  "description": "A simple Chrome extension to manage text snippets and screenshots. Now featuring text to speech!",
  "version": "1.0",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "desktopCapture"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}